            "fr": "90 %",
            "de": "90 %",
            "es": "90 %"
          }
        }
      ]
    },
    {
      "key": "interval",
      "type": "select",
      "label": {
        "en": "Analysis interval",
        "fr": "Intervalle d'analyse",
        "de": "Analyseintervall",
        "es": "Intervalo de análisis"
      },
      "description": {
        "en": "Each added camera is analyzed this often, one after the other. Every analysis takes CPU on the DOODS machine.",
        "fr": "Chaque caméra ajoutée est analysée à ce rythme, l'une après l'autre. Chaque analyse consomme du processeur sur la machine de DOODS.",
        "de": "Jede hinzugefügte Kamera wird in diesem Takt analysiert, eine nach der anderen. Jede Analyse kostet CPU auf dem DOODS-Rechner.",
        "es": "Cada cámara añadida se analiza con esta frecuencia, una tras otra. Cada análisis consume CPU en la máquina de DOODS."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "0",
          "label": {
            "en": "On demand only",
            "fr": "À la demande seulement",
            "de": "Nur auf Anfrage",
            "es": "Solo bajo demanda"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
