  "actions": [
    {
      "key": "check",
      "label": {
        "en": "Check the connection",
        "fr": "Vérifier la connexion",
        "de": "Verbindung prüfen",
        "es": "Comprobar la conexión"
      },
      "description": {
        "en": "Asks DOODS for its detectors, then analyzes each camera once.",
        "fr": "Demande ses détecteurs à DOODS, puis analyse chaque caméra une fois.",
        "de": "Fragt DOODS nach seinen Detektoren und analysiert dann jede Kamera einmal.",
        "es": "Pide sus detectores a DOODS y analiza cada cámara una vez."
      },
      "timeout_seconds": 120
