{
  "manifest_version": 1,
  "type": "device",
  "name": "DOODS",
  "description": {
    "en": "Local object detection on your camera images with DOODS: person, car, cat… without the cloud.",
    "fr": "Détection locale d’objets sur vos caméras avec DOODS : personne, voiture, chat… sans cloud",
    "de": "Lokale Objekterkennung in deinen Kamerabildern mit DOODS: Person, Auto, Katze… ohne Cloud.",
    "es": "Detección local de objetos en las imágenes de sus cámaras con DOODS: persona, coche, gato… sin nube."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-doods:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-doods/main/cover.png",
  "categories": ["security"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your DOODS server",
        "fr": "Votre serveur DOODS",
        "de": "Dein DOODS-Server",
        "es": "Su servidor DOODS"
      },
      "description": {
        "en": "DOODS detects objects (person, car, cat…) in pictures, on your own machine. Enter its address, then up to four cameras below, and open the Discovery tab: one device per camera.",
        "fr": "DOODS détecte les objets (personne, voiture, chat…) dans des images, sur votre propre machine. Saisissez son adresse, puis jusqu'à quatre caméras ci-dessous, et ouvrez l'onglet Découverte : un appareil par caméra.",
        "de": "DOODS erkennt Objekte (Person, Auto, Katze…) in Bildern, auf deinem eigenen Rechner. Gib seine Adresse und unten bis zu vier Kameras ein und öffne dann den Tab „Entdecken“: ein Gerät pro Kamera.",
        "es": "DOODS detecta objetos (persona, coche, gato…) en imágenes, en su propia máquina. Introduzca su dirección y hasta cuatro cámaras más abajo, y abra la pestaña Descubrir: un dispositivo por cámara."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-doods/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "DOODS address",
        "fr": "Adresse de DOODS",
        "de": "DOODS-Adresse",
        "es": "Dirección de DOODS"
      },
      "description": {
        "en": "Without a port, 8080 is used. Add https:// for a reverse proxy.",
        "fr": "Sans port, 8080 est utilisé. Ajoutez https:// derrière un proxy inverse.",
        "de": "Ohne Port wird 8080 verwendet. Füge https:// hinter einem Reverse-Proxy hinzu.",
        "es": "Sin puerto, se usa el 8080. Añada https:// detrás de un proxy inverso."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.20",
        "fr": "ex. 192.168.1.20",
        "de": "z. B. 192.168.1.20",
        "es": "p. ej. 192.168.1.20"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "detector",
      "type": "string",
      "label": {
        "en": "Detector",
        "fr": "Détecteur",
        "de": "Detektor",
        "es": "Detector"
      },
      "description": {
        "en": "Name of a DOODS detector: default (fast, tflite), tensorflow (more accurate, slower)… The Check action lists them.",
        "fr": "Nom d'un détecteur DOODS : default (rapide, tflite), tensorflow (plus précis, plus lent)… L'action Vérifier les liste.",
        "de": "Name eines DOODS-Detektors: default (schnell, tflite), tensorflow (genauer, langsamer)… Die Aktion Prüfen listet sie auf.",
        "es": "Nombre de un detector de DOODS: default (rápido, tflite), tensorflow (más preciso, más lento)… La acción Comprobar los enumera."
      },
      "required": false,
      "default": "default"
    },
    {
      "key": "labels",
      "type": "string",
      "label": {
        "en": "Objects to look for",
        "fr": "Objets recherchés",
        "de": "Gesuchte Objekte",
        "es": "Objetos buscados"
      },
      "description": {
        "en": "Detector labels in English, separated by commas (up to 8, each one a counter). * = every label. A camera can have its own list.",
        "fr": "Étiquettes du détecteur en anglais, séparées par des virgules (8 au plus, chacune un compteur). * = toutes. Une caméra peut avoir sa propre liste.",
        "de": "Labels des Detektors auf Englisch, durch Kommas getrennt (bis zu 8, je ein Zähler). * = alle. Eine Kamera kann ihre eigene Liste haben.",
        "es": "Etiquetas del detector en inglés, separadas por comas (hasta 8, cada una un contador). * = todas. Una cámara puede tener su propia lista."
      },
      "placeholder": {
        "en": "person, car, cat, dog",
        "fr": "person, car, cat, dog",
        "de": "person, car, cat, dog",
        "es": "person, car, cat, dog"
      },
      "required": false,
      "default": "person, car, cat, dog"
    },
    {
      "key": "confidence",
      "type": "select",
      "label": {
        "en": "Minimum confidence",
        "fr": "Confiance minimale",
        "de": "Mindestkonfidenz",
        "es": "Confianza mínima"
      },
      "description": {
        "en": "Detections below are ignored. Higher: fewer false alarms, more misses.",
        "fr": "Les détections en dessous sont ignorées. Plus haut : moins de fausses alertes, plus d'oublis.",
        "de": "Erkennungen darunter werden ignoriert. Höher: weniger Fehlalarme, mehr Übersehenes.",
        "es": "Las detecciones por debajo se ignoran. Más alta: menos falsas alarmas, más omisiones."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "30",
          "label": {
            "en": "30 %",
            "fr": "30 %",
            "de": "30 %",
            "es": "30 %"
          }
        },
        {
          "value": "40",
          "label": {
            "en": "40 %",
            "fr": "40 %",
            "de": "40 %",
            "es": "40 %"
